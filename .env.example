# Local development uses SQLite so no external services are required.
DATABASE_URL="file:./dev.db"

# Public base URL used in verification / invitation / reset links.
APP_URL="http://localhost:3000"

# Used to sign session cookies and encrypt provider tokens at rest.
SESSION_SECRET="replace-with-a-long-random-string"
TOKEN_ENCRYPTION_KEY="replace-with-a-32-byte-random-string"

# mock | real. Real mode needs META_APP_ID and META_APP_SECRET.
META_MODE="mock"
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/oauth/meta/callback"

# Optional. When empty the Discord bot is reported as not configured.
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Optional AI insight text. Heuristics work without it.
ANTHROPIC_API_KEY=""

# Optional SMTP (Mailpit locally: smtp://localhost:1025). Without it links are
# written to the server console and exposed in dev-only UI hints.
SMTP_URL=""

# Optional Postgres/Redis/MinIO configuration for the production-style stack.
POSTGRES_URL=""
REDIS_URL=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
